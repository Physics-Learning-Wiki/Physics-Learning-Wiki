{
  "version": 1,
  "prng_vectors": [
    {
      "seed": "test-seed",
      "expected_floats": [0.3584189757, 0.5269410228, 0.1207547213]
    },
    {
      "seed": "quantum-🚀-2026",
      "expected_floats": [0.1544812980, 0.1592011821, 0.1596197132]
    }
  ],
  "shuffle_vectors": [
    {
      "seed": "seed-abc",
      "input": ["q1", "q2", "q3", "q4", "q5"],
      "expected": ["q2", "q3", "q5", "q1", "q4"]
    },
    {
      "seed": "🚀-shuffle",
      "input": ["A", "B", "C", "D"],
      "expected": ["D", "A", "B", "C"]
    }
  ],
  "solvers": {
    "overlapping_slots": {
      "pool": [
        {"id": "q1", "topicIds": ["mechanics.dynamics"], "topics": ["mechanics.dynamics"]},
        {"id": "q2", "topicIds": ["mechanics.dynamics"], "topics": ["mechanics.dynamics"]}
      ],
      "query": {
        "type": "query",
        "count": 2,
        "slots": [
          {"id": "slot-a", "count": 1, "filters": {"question_ids": ["q1", "q2"]}},
          {"id": "slot-b", "count": 1, "filters": {"question_ids": ["q1"]}}
        ]
      },
      "expected_ids": ["q1", "q2"]
    },
    "composition_constraints": {
      "pool": [
        {"id": "q1", "difficulty": 1},
        {"id": "q2", "difficulty": 2},
        {"id": "q3", "difficulty": 2},
        {"id": "q4", "difficulty": 1}
      ],
      "query": {
        "type": "query",
        "count": 2,
        "slots": [
          {"id": "slot-a", "count": 1, "filters": {"question_ids": ["q1", "q2"]}}
        ],
        "constraints": [
          {"field": "difficulty", "values": [1], "min": 2, "max": 2}
        ]
      },
      "expected_ids": ["q1", "q4"]
    },
    "diagnostics": {
      "insufficient_pool": {
        "pool": [
          {"id": "q1"},
          {"id": "q2"}
        ],
        "query": {
          "type": "query",
          "count": 3
        },
        "expected_status": "infeasible",
        "expected_reason_code": "insufficient_pool"
      },
      "slot_conflict": {
        "pool": [
          {"id": "q1"},
          {"id": "q2"}
        ],
        "query": {
          "type": "query",
          "count": 2,
          "slots": [
            {"id": "slot-a", "count": 1, "filters": {"question_ids": ["q1"]}},
            {"id": "slot-b", "count": 1, "filters": {"question_ids": ["q1"]}}
          ]
        },
        "expected_status": "infeasible",
        "expected_reason_code": "slot_conflict"
      },
      "constraint_violation": {
        "pool": [
          {"id": "q1", "difficulty": 2},
          {"id": "q2", "difficulty": 2}
        ],
        "query": {
          "type": "query",
          "count": 2,
          "constraints": [
            {"field": "difficulty", "values": [1], "min": 1}
          ]
        },
        "expected_status": "infeasible",
        "expected_reason_code": "constraint_violation"
      }
    }
  }
}
